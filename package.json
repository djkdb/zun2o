{
  "name": "phone-0200",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "12% — 새벽 2시, 해원고 전화부스 괴담. 주운 휴대폰 호러 게임 (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "qa": "node scripts/playtest.mjs && node scripts/playtest2.mjs",
    "deploy:cf": "npm run build && npx wrangler deploy",
    "icons": "node scripts/icons.mjs",
    "qa:layout": "node scripts/layout.mjs",
    "voices": "node --experimental-strip-types --no-warnings scripts/voices.mjs",
    "voices:list": "node --experimental-strip-types --no-warnings scripts/voices.mjs list",
    "voices:fx": "node --experimental-strip-types --no-warnings scripts/voices.mjs fx",
    "voices:eleven": "node --experimental-strip-types --no-warnings scripts/voices.mjs eleven",
    "sfx": "node scripts/sfx.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@fontsource/nanum-pen-script": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright-core": "^1.56.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
